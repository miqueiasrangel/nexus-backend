PORT=3333

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=

# Coleta automática dos REPs do SEST
REP_1_HOST=
REP_1_USER=
REP_1_PASSWORD=
REP_2_HOST=
REP_2_USER=
REP_2_PASSWORD=
REP_LOGIN_PATH=/login.fcgi
REP_EXPORT_PATH=/export_users_csv.fcgi
REP_TIMEOUT_MS=15000
REP_TLS_VERIFY=false
# Compatibilidade com a resposta HTTP não estritamente RFC dos REPs legados
REP_INSECURE_HTTP_PARSER=true

# Sincronização SEST
SEST_SYNC_USER=SISTEMA_NEXUS_SEST
# A LISTA DASS semanal é um snapshot completo; estes valores reproduzem a
# reconciliação do fluxo Django sem recriar as tabelas físicas.
SEST_REMOVE_MISSING=true
SEST_SHEET_REMOVE_MISSING=true
